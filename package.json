{
  "name": "@dtlabs/ai-toolkit",
  "version": "0.12.0",
  "description": "AI Toolkit — reusable agents and procedures for developers to build AI-powered applications.",
  "files": [
    "docs/",
    "CLAUDE.md",
    "CHANGELOG.md",
    "README.md",
    "CLAUDE.global.md",
    "src/claude",
    "lib",
    "bin"
  ],
  "bin": {
    "ai-toolkit": "bin/cli.js"
  },
  "scripts": {
    "prepublishOnly": "npm pack --dry-run",
    "prepack": "node bin/cli.js validate-purity",
    "toolkit:validate-purity": "node bin/cli.js validate-purity",
    "toolkit:dev-install-global": "node bin/cli.js --global --dry-run && node bin/cli.js --global && node bin/cli.js doctor resolution && node bin/cli.js verify-install",
    "test": "jest --bail",
    "test:cli": "jest --bail --testPathPattern=tests/cli/",
    "test:frontmatter": "jest --bail --testPathPattern=tests/frontmatter/",
    "test:regression": "jest --bail --testPathPattern=tests/regression/",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "jest": "^29.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dtlab-tech/ai-toolkit"
  },
  "author": "Denis Tomada",
  "license": "MIT"
}
